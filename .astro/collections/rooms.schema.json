{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "alt"
        ]
      }
    },
    "capacity": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "beds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "quantity"
        ]
      }
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "count": {
          "type": "number"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "count",
        "label"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "heroImage",
    "images",
    "capacity",
    "beds",
    "amenities"
  ]
}