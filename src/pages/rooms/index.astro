---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import Layout from '@/layouts/Layout.astro';
import ZuttoSushi from "@/components/sections/ZuttoSushi.astro";
import Wrapper, {
  Sidebar,
  Content as RoomContent,
} from "@/components/rooms/Wrapper";
import Facilities from "@/components/rooms/Facilities";
import { actions } from "astro:actions";

const rooms = (await getCollection("rooms"))
  .sort((a, b) => a.data.order && b.data.order && a.data.order - b.data.order) || 0;
---
<Layout title="Rooms | Tusker Lodge">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-slate max-w-none text-gray-700">
      <h1 class="text-center">Our Rooms</h1>
      <p>
        Our accommodation comprises of Single rooms and Double rooms.
        The bedrooms are spread over our three story Guest House with
        various south facing rooms having views over picturesque Torwood
        gardens. To the front of the property is a large south east facing
        terraced patio area also overlooking Torwood gardens.
      </p>
    </div>
  </div>

  <div class="container mx-auto flex flex-col gap-6 items-center my-12">
    <div class="flex flex-col gap-5">
      {rooms.map((r, i) => (
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-4 place-items-center">
          <div class={`w-full md:col-span-6 ${i % 2 !== 0 ? 'md:order-2 md:col-start-7' : 'md:col-start-1'}`}>
            <!-- image carousel -->
            <div class="relative group">
              <div id={`images-room-${i}`}
                class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth w-full rounded-lg [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
                {r.data.images.map((img, index) => (
                  <Image
                    class="w-full h-[300px] md:h-[400px] object-cover rounded-lg"
                    src={img.src}
                    alt={img.alt}
                    width={100}
                    height={100}
                    loading={index === 0 ? "eagar" : "lazy"}
                  />
                ))}
              </div>
              <button
                id="prev"
                data-images={`images-room-${i}`}
                class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/70 hover:bg-white text-black p-2 rounded-full shadow opacity-0 group-hover:opacity-100 transition-opacity"
                aria-label="Previous slide"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
              </button>
              <button
                id="next"
                data-images={`images-room-${i}`}
                class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/70 hover:bg-white text-black p-2 rounded-full shadow opacity-0 group-hover:opacity-100 transition-opacity"
                aria-label="Next slide"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          </div>
          <div class={`w-full relative group md:col-span-4 px-4 md:px-0 ${i % 2 !== 0 ? 'md:order-1 md:col-start-2' : 'md:col-start-8'}`}>
            <div class="overflow-hidden">
              <h2 class="text-xl font-bold">{r.data.title}</h2>
              <p>{r.data.description}</p>
              <a class="flex py-3" href={`/rooms/${r.id}`}>
                <span class="absolute inset-0"></span>
                <span>more details</span>
                <span class="transition-all group-hover:translate-x-4">
                  <Icon name="arrow-right" size="1.5em" />
                </span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
  <ZuttoSushi />
  <script>
    const prevButtons = document.querySelectorAll("button#prev");
    const nextButtons = document.querySelectorAll("button#next");

    const scrollEvent = (direction) => {
      return (e) => {
        const carousel = document.getElementById(e.currentTarget.getAttribute("data-images"));
        carousel.scrollBy({ left: carousel.clientWidth * direction, behavour: "smooth"});
      }
    };

    for(const btn of prevButtons) {
      btn.addEventListener("click", scrollEvent(-1));
    };

    for(const btn of nextButtons) {
      btn.addEventListener("click", scrollEvent(1));
    }
  </script>
</Layout>
