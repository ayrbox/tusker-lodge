---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from '@/layouts/Layout.astro';
import Wrapper, {
  Sidebar,
  Content as RoomContent,
} from "@/components/rooms/Wrapper";
import Facilities from "@/components/rooms/Facilities";
import { actions } from "astro:actions";

  const rooms = await getCollection("rooms");
  const roomSorted = rooms.sort((a, b) => {
    console.log(">>>>",a, a.data.order, b.data.order);
    if (a.data.order && b.data.order) {
      console.log(">>>>", a.data.order, b.data.order);
      return a.data.order - b.data.order;
    }
    return 0;
  });

