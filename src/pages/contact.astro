---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact | Tusker Lodge">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-2">Contact Us</h1>
    <p class="text-sm mb-8 text-gray-500">
      You can call us, email us or visit us directly.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="space-y-8">
        <h2 class="text-2xl font-bold mb-6">Get in Touch</h2>
        <div class="p-6 space-y-6">
          <div class="flex gap-4">
            <Icon name="mappin" class="text-indigo-600 mt-1" size="1.2em" />
            <address class="not-italic text-gray-700">
              Tusker Lodge<br />
              533 Babbacombe Road<br />
              Torquay,<br />
              Devon<br />
              TQ1 1HQ
            </address>
          </div>

          <div class="flex gap-4">
            <Icon name="phone" class="text-indigo-600 mt-1" size="1.2em" />
            <a class="text-indigo-600" href="tel:+441803292668">01803 292668</a>
          </div>

          <div class="flex gap-4">
            <Icon name="mail" class="text-indigo-600 mt-1" size="1.2em" />
            <p>
              <a
                href="mailto:tuskerlodge@gmail.com"
                class="text-indigo-600 hover:underline"
              >
                tuskerlodge@gmail.com
              </a>
            </p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold mb-6">Essential Details</h2>
        <div class="bg-gray-50 rounded-lg p-6 space-y-6">
          <div>
            <h3 class="font-semibold text-gray-900">Check-in Window</h3>
            <p class="text-gray-700 mt-1">
              15:00 &ndash; 20:00<br />
              <span class="text-sm text-gray-500"
                >Late self-check-in can be arranged upon request.</span
              >
            </p>
          </div>

          <div>
            <h3 class="font-semibold text-gray-900">Check-out Time</h3>
            <p class="text-gray-700 mt-1">By 10:30 AM</p>
          </div>

          <div>
            <h3 class="font-semibold text-gray-900">Reception / Phone Hours</h3>
            <p class="text-gray-700 mt-1">08:00 &ndash; 21:00 daily</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 bg-indigo-50 border border-indigo-100 rounded-lg p-8">
      <h2 class="text-2xl font-bold text-indigo-900 mb-4">Book Direct &amp; Save</h2>
      <p class="text-indigo-800 leading-relaxed mb-4">
        We encourage you to book directly with us! By booking direct, you help us save on third-party commissions&mdash;savings we can pass directly on to you.
      </p>
      <p class="text-indigo-800 leading-relaxed">
        However, we understand that many guests prefer the familiarity of platforms like Booking.com for securely managing their personal information (PII) and travel details, and we respectfully provide that option for your peace of mind.
      </p>
    </div>

    <div class="mt-16 border-t border-gray-200 pt-12">
      <h2 class="text-2xl font-bold mb-8">Location & Directions</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="space-y-8">
          <div>
            <h3 class="text-xl font-semibold mb-3">Arrival by Car</h3>
            <p class="text-gray-700 leading-relaxed mb-2">
              From the main A380/Penn Inn roundabout, follow signs for Torquay.
              Continue straight onto the A3022, then follow signs for
              Babbacombe.
            </p>
            <p class="text-gray-700 leading-relaxed font-medium">
              We offer free on-site parking for guests. The entrance to our car
              park is directly accessible from Babbacombe Road.
            </p>
          </div>

          <div>
            <h3 class="text-xl font-semibold mb-3">Public Transport</h3>
            <p class="text-gray-700 leading-relaxed mb-2">
              <strong>From Torquay Railway Station:</strong> We are approximately
              a 5–8 minute taxi ride away. Alternatively, local bus routes connect
              the station to Babbacombe Road.
            </p>
            <p class="text-gray-700 leading-relaxed">
              <strong>Bus Stops:</strong> The closest bus stops are located just a
              short walk away on Babbacombe Road, providing easy access to the harbour
              and town centre.
            </p>
          </div>
        </div>
        <div
          class="h-64 md:h-full min-h-[350px] rounded-lg overflow-hidden shadow-md"
        >
          <iframe
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Tusker Lodge Location on Google Maps"
            src="https://maps.google.com/maps?width=600&height=400&hl=en&q=533 Babbacombe Rd, Torquay TQ1 1HQ&t=&z=14&ie=UTF8&iwloc=B&output=embed"
          ></iframe>
          <a href="https://embed-googlemap.com">google maps embed</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
