---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  const policyEntries = await getCollection('policies');
  return policyEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">{entry.data.title}</h1>
    <p class="text-sm text-gray-500 italic mb-8">Last updated: {entry.data.lastUpdated}</p>
    <div class="prose prose-slate max-w-none text-gray-700">
      <Content />
    </div>
  </div>
</Layout>
