---
import CTA from "@/components/CTA.astro";
import { externalLinks } from "@/data/externalLinks";
---

<section
  class="relative bg-cover bg-no-repeat bg-center"
  style={{
    backgroundImage: `url(/images/featured-torquay-harbour.jpg)`,
  }}
>
  <div
    class="relative container mx-auto px-8 py-32 xl:p-40 flex flex-col text-center md:text-left"
  >
    <h1 class="text-5xl md:text-6xl text-gray-200 text-shadow-lg">
      Experience Torquay with
      <span class="font-bold"> Tusker Lodge</span>
    </h1>
    <p class="my-8 text-gray-200 font-bold">
      Sandy welcomes you to Tusker Lodge in Torquay Harbour, located in heart of
      English Riviera.
    </p>
    <div class="flex flex-col md:flex-row gap-4 justify-items-end">
      <CTA href={externalLinks.bookingDirectly}> Book Directly </CTA>
      <CTA href={externalLinks.bookingDotCom} variant="booking">
        Booking.com
      </CTA>
    </div>
  </div>
</section>
