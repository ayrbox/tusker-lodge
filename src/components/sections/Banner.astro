---
type Props = {
  title: string;
  path: string;
};

const { title, path } = Astro.props;
---

<section
  class="relative bg-cover bg-no-repeat bg-center"
  style={{
    backgroundImage: `url(images/torquay-banner.jpg)`,
  }}
>
  <div class="absolute inset-0 bg-gray-900 opacity-50"></div>
  <div class="relative container mx-auto py-10 flex flex-col text-center">
    <h1 class="text-2xl md:text-3xl font-bold text-gray-200 text-shadow-lg">
      {title}
    </h1>
    <p class="my-4 text-gray-200">{path}</p>
  </div>
</section>
