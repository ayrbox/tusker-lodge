---
import { Icon } from "astro-icon/components";

export type RoomProps = {
  image: { src: string };
  name: string;
  href: string;
};

const roomsInfo: RoomProps[] = [
  {
    name: "Triple Room",
    image: "images/rooms/room-03-03.jpg",
    href: "./rooms/family",
  },
  {
    name: "King Room",
    image: "images/rooms/king.jpg",
    href: "./rooms/king",
  },
  {
    name: "Doubles",
    image: "images/rooms/doubles.jpg",
    href: "./rooms/doubles",
  },
  {
    name: "Singles",
    image: "images/rooms/singles.jpg",
    href: "./rooms/singles",
  },
];

---
<section class="flex">
  <div class="container mx-auto flex flex-col gap-6 items-center text-center">
    <div class="p-4 flex flex-col gap-8 text-center items-center">
      <h1 class="text-3xl text-gray-700 font-bold">Our Rooms</h1>
      <p class="text-gray-500">
        Choose from 9 comfortable rooms – singles, doubles, or triples to
        suit your needs. Each comes with TV and all essential amenities at
        reasonable prices. Simple, comfortable, and everything you need for
        a relaxing stay.
      </p>
      <a class="flex group" href="./rooms">
        <span>Find more </span>
        <span class="transition-all group-hover:translate-x-4">
          <Icon name="arrow-right" size="1.5em" />
        </span>
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {roomsInfo.map((r) => (
        <div class="relative group border-2 rounded-xl overflow-hidden border-stone-200 ">
            <img
              class="object-cover"
              src={r.image}
              alt={r.name}
            />

            <a class="flex justify-center py-3" href={r.href}>
              <span class="absolute inset-0"></span>
              <span class="text-xl font-bold">{r.name}</span>
              <span class="transition-all group-hover:translate-x-4">
                <Icon name="arrow-right" size="1.5em" />
              </span>
            </a>
        </div>
      ))}
    </div>
    
  </div>
</section>
