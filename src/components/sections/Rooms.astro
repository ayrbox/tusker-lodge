---
import { Icon } from "astro-icon/components";

export type RoomProps = {
  image: { src: string };
  name: string;
  href: string;
};

const roomsInfo: RoomProps[] = [
  {
    name: "Triple Room",
    image: "images/rooms/room-03-03.jpg",
    href: "./rooms/family",
  },
  {
    name: "King & Queen Room",
    image: "images/rooms/king.jpg",
    href: "./rooms/king",
  },
  {
    name: "Doubles",
    image: "images/rooms/doubles.jpg",
    href: "./rooms/doubles",
  },
  {
    name: "Singles",
    image: "images/rooms/singles.jpg",
    href: "./rooms/singles",
  },
];

---
<section class="flex flex-col xl:flex-row-reverse">
  <div class="xl:w-1/2 px-8 py-8 flex justify-center items-center">
    <div class="p-4 flex flex-col gap-8 text-center items-center">
      <h1 class="text-3xl text-gray-700 font-bold">Our Rooms</h1>
      <p class="text-gray-500">
        Choose from 9 comfortable rooms – singles, doubles, or triples to
        suit your needs. Each comes with TV and all essential amenities at
        reasonable prices. Simple, comfortable, and everything you need for
        a relaxing stay.
      </p>
      <a class="flex group" href="./rooms">
        <span>Find more </span>

        <span class="transition-all group-hover:translate-x-4">
          <Icon name="arrow-right" size="1.5em" />
        </span>
      </a>
    </div>
  </div>
  <div class="xl:w-1/2 grid md:grid-cols-2 h-dvh xl:h-[32rem]">
    {roomsInfo.map((r) => (
      <div class="relative group text-white">
        <div aria-hidden="true" class="absolute inset-0">
          <img
            class="object-cover h-full w-full"
            src={r.image}
            alt={r.name}
          />
        </div>
        <div class="absolute inset-0 bg-linear-to-t from-[#1a627d] to-transparent"></div>
        <div class="absolute inset-0 p-4 flex items-end">
          <div>
            <h3 class="text-xl font-bold">{r.name}</h3>
            <a class="flex" href={r.href}>
              <span class="absolute inset-0"></span>
              <span>View</span>
              <span class="transition-all group-hover:translate-x-4">
                <Icon name="arrow-right" size="1.5em" />
              </span>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
