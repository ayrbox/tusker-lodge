---
import TestimonialCard from "@/components/TestimonialCard.astro";
import { getCollection } from "astro:content";
const testimonials = await getCollection("testimonials");
---

<section class="py-32">
  <div class="container mx-auto flex flex-col gap-6 items-center text-center">
    <h2 class="text-3xl text-primary font-bold mb-10">Testimonials</h2>

    <ul class="flex flex-col gap-6">
      {
        testimonials.map((t) => (
          <li class="xl:odd:translate-x-80">
            <TestimonialCard
              title={t.data.title}
              text={t.data.text}
              name={t.data.name}
              source={t.data.source}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
