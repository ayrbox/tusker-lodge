---
<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-50 p-4 bg-black text-white transition-transform duration-500 ease-in-out translate-y-full"
>
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm">
      We use cookies to ensure you get the best experience on our website.
      By continuing to use this site, you agree to our use of cookies.
    </p>
    <div class="flex items-center gap-4">
      <button
        id="accept-cookies-btn"
        class="text-white underline hover:no-underline font-medium px-4 py-2 border border-white rounded hover:bg-white hover:text-black transition-colors"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const acceptBtn = document.getElementById('accept-cookies-btn');

  const hasConsent = document.cookie.split('; ').find(row => row.startsWith('cookieConsent='));

  if (banner && acceptBtn) {
    if (!hasConsent) {
      banner.classList.remove('translate-y-full');
    }

    acceptBtn.addEventListener('click', () => {
      const maxAge = 30 * 24 * 60 * 60;
      document.cookie = `cookieConsent=true; max-age=${maxAge}; path=/; SameSite=Lax`;
      banner.classList.add('translate-y-full');
    });
  }
</script>
