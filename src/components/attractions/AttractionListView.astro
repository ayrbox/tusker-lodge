---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { slugifyCategory, type CategoryInfo } from '@/utils/attractions';

interface Props {
  page: Page<CollectionEntry<'attractions'>>;
  categories: CategoryInfo[];
  activeCategory: string;
  basePath: string;
}

const { page, categories, activeCategory, basePath } = Astro.props;

const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => {
  const num = i + 1;
  const href= num === 1 ? basePath : `${basePath.replace(/\/+$/,"")}/${num}/`;
  return {
    num,
    href,
    isCurrent: num === page.currentPage,
  };
});
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
  <!-- Blog-style Header -->
  <div class="max-w-3xl mx-auto text-center mb-10 md:mb-12">
    <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-sky-700 bg-sky-50 rounded-full mb-3">
      English Riviera Guide
    </span>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 tracking-tight mb-4">
      {activeCategory === 'All' ? 'Local Attractions & Things to Do' : activeCategory}
    </h1>
    <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
      Discover museums, historic landmarks, coastal walks, and live theatres all within easy reach of 
      <a href="/" class="text-sky-700 hover:text-sky-900 underline underline-offset-2 mx-1">Tusker Lodge</a>
      at 533 Babbacombe Road, Torquay.
    </p>
  </div>

  <!-- Server-rendered Category Filter Links -->
  <nav
    class="flex flex-wrap items-center justify-center gap-2 mb-10"
    aria-label="Filter attractions by category"
  >
    {categories.map((category) => {
      const isActive = category.name === activeCategory;
      return (
        <a
          href={category.href}
          aria-current={isActive ? 'page' : undefined}
          class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
            isActive
              ? 'bg-sky-700 text-white shadow-sm'
              : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
          }`}
        >
          {category.name}
        </a>
      );
    })}
  </nav>

  <!-- Blog Card Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {page.data.map((attraction) => {
      const categorySlug = slugifyCategory(attraction.data.category);
      return (
        <article class="group flex flex-col bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <a href={`/attractions/${attraction.id}/`}
            class="block relative aspect-[16/10] w-full overflow-hidden bg-slate-100"
          >
            <img
              src={`${attraction.data.image}`}
              alt={`${attraction.data.name}`}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </a>
          <div class="flex flex-col flex-1 p-5 sm:p-6">
            <div class="mb-3">
              <a href={`/attractions/category/${categorySlug}/`}
                class="inline-block px-2.5 py-0.5 text-xs font-semibold text-sky-700 bg-sky-50 hover:bg-sky-100 rounded-full transition-colors"
              >
                {attraction.data.category}
              </a>
            </div>

            <h2 class="text-lg sm:text-xl font-bold text-gray-900 leading-snug mb-2 group-hover:text-sky-700 transition-colors">
              <a href={`/attractions/${attraction.id}/`} class="hover:underline underline-offset-2">
                {attraction.data.name}
              </a>
            </h2>

            {attraction.data.description && (
              <p class="text-sm text-gray-600 leading-relaxed line-clamp-3 mb-4">
                {attraction.data.description}
              </p>
            )}

            <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between text-sm">
              <a href={`/attractions/${attraction.id}/`}
                class="inline-flex items-center font-semibold text-sky-700 hover:text-sky-900 transition-colors"
              >
                Read guide
                <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Server-rendered Pagination Controls -->
  {page.lastPage > 1 && (
    <div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-gray-200 pt-8">
      <p class="text-sm text-gray-600">
        Showing {page.start + 1}–{page.end + 1} of {page.total} guides
      </p>
      <nav aria-label="Attractions pagination" class="flex items-center gap-1.5 flex-wrap justify-center">
        {page.url.prev ? (
          <a
            href={page.url.prev}
            class="px-3.5 py-2 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 transition-colors"
          >
            Previous
          </a>
        ) : (
          <span class="px-3.5 py-2 text-sm font-medium rounded-lg border border-gray-200 bg-gray-50 text-gray-400 cursor-not-allowed">
            Previous
          </span>
        )}

        <div class="flex items-center gap-1.5">
          {pageNumbers.map((item) => (
            <a
              href={item.href}
              aria-label={`Page ${item.num}`}
              aria-current={item.isCurrent ? 'page' : undefined}
              class={`inline-flex items-center justify-center w-9 h-9 text-sm rounded-lg transition-colors ${
                item.isCurrent
                  ? 'font-semibold bg-sky-700 text-white shadow-sm'
                  : 'font-medium border border-gray-300 bg-white text-gray-700 hover:bg-gray-50'
              }`}
            >
              {item.num}
            </a>
          ))}
        </div>

        {page.url.next ? (
          <a
            href={page.url.next}
            class="px-3.5 py-2 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 transition-colors"
          >
            Next
          </a>
        ) : (
          <span class="px-3.5 py-2 text-sm font-medium rounded-lg border border-gray-200 bg-gray-50 text-gray-400 cursor-not-allowed">
            Next
          </span>
        )}
      </nav>
    </div>
  )}
</section>
