---
import { Icon } from 'astro-icon/components'
import clsx from "clsx"
import CTA from "./CTA.astro"
import NavItem from "./NavItem.astro"

type Nav = {
  name: string;
  text: string;
  url: string;
};

const navigations: Nav[] = [
  {
    name: "home",
    text: "Home",
    url: "/",
  },
  {
    name: "our-rooms",
    text: "Rooms",
    url: "/rooms",
  },
  {
    name: "attractions",
    text: "Attractions",
    url: "/attractions",
  },
  {
    name: "pets",
    text: "Pets",
    url: "/pets",
  },
  {
    name: "parking",
    text: "Parking",
    url: "/parking",
  },
  {
    name: "contact",
    text: "Contact",
    url: "/contact",
  },
];

const menu = false;
---
<div class="p-8">
  <div class="container mx-auto py-3 flex justify-between items-center">
    <a href="/">
      <img
        src="/logo.jpg"
        alt="Tusker Lodge Logo"
        width={200}
        height={60}
      />
    </a>

    {/* Desktop horizontal menu */}
    <ol class="hidden xl:flex align-items gap-6">
      {navigations.map((n) => (
        <li key={n.name}>
          <NavItem text={n.text} url={n.url} />
        </li>
      ))}
    </ol>

    <div class="flex items-center content-center gap-x-2">
      <div class="hidden relative xl:grid grid-cols-[auto_1fr] gap-x-2 items-center text-gray-700 mr-4">
        <div class="p-3 row-span-2 rounded-full bg-orange-500">
          <Icon name="phone"  />
        </div>
        <p class="text-gray-400 text-sm">Call Us</p>
        <p class="text-gray-700 font-semibold">
          <a href="tel:+441803292668">
            <span class="absolute inset-0"></span>
            +44 1803 292668
          </a>
        </p>
      </div>

      <CTA
        href={import.meta.env.PUBLIC_BOOKING_DIRECTLY}
        class="hidden md:block"
      >
        Book Directly
      </CTA>
      <CTA
        href={import.meta.env.PUBLIC_BOOKING_DOT_COM}
        variant="booking"
        class="hidden md:block"
      >
        Booking.com
      </CTA>

      {/* Mobile burger menu button */}
      <button
        class="block xl:hidden p-2 rounded-md hover:bg-gray-100 transition-colors"
        aria-label="Open menu"
      >
        <span class="h-6 w-6">Burger menu was here</span>
      </button>
    </div>

    {/* Overlay */}
    <div
      class={clsx(
        "fixed inset-0 bg-black bg-opacity-50 z-40 transition-opacity duration-300",
        menu ? "opacity-100" : "opacity-0 pointer-events-none",
      )}
      role="button"
    ></div>

    {/* Sidebar menu */}
    <aside
      class={clsx(
        "fixed top-0 right-0 h-full bg-white shadow-lg z-50 transition-transform duration-300 ease-in-out",
        "w-80 max-w-[85vw]",
        menu ? "translate-x-0" : "translate-x-full",
      )}
    >
      <div class="flex flex-col h-full">
        {/* Header */}
        <div class="flex items-center justify-between p-4 border-b border-gray-200">
          <img
            src="/logo.jpg"
            alt="Tusker Lodge Logo"
            width={200}
            height={60}
          />
          <button
            class="p-2 rounded-md hover:bg-gray-100 transition-colors"
            aria-label="Close menu"
          >
            <span class="h-6 w-6">XICon</span>
          </button>
        </div>

        {/* Navigation */}
        <nav class="flex-1 px-4 py-6">
          <ol class="space-y-4">
            {navigations.map((n) => (
              <li key={n.name}>
                <a
                  href={n.url}
                  class="block py-3 px-4 text-gray-700 hover:text-orange-500 hover:bg-orange-50 rounded-lg transition-colors text-lg font-medium"
                >
                  {n.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>

        {/* Footer with contact and booking */}
        <div class="border-t border-gray-200 p-4 space-y-4">
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3 text-gray-700">
              <div class="p-2 rounded-full bg-orange-500">
                <span class="text-orange-100 h-4 w-4">Phone Call Icon</span>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Call Us</p>
                <p class="font-semibold">
                  <a href="tel:+441803292668">+44 1803 292668</a>
                </p>
              </div>
            </div>

            <CTA href={import.meta.env.PUBLIC_BOOKING_DIRECTLY}>
              Book Directly
            </CTA>
            <CTA
              href={import.meta.env.PUBLIC_BOOKING_DOT_COM}
              variant="booking"
            >
              Booking.com
            </CTA>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>
